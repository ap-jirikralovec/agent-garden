{
  "name": "agent-garden",
  "version": "0.1.0",
  "description": "A local playground for your Codex and Claude agents",
  "type": "module",
  "bin": {
    "agent-garden": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "node --import tsx src/server/cli.ts --dev",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/cli.js",
    "type-check": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "check:codex": "node --import tsx scripts/check-codex.ts",
    "check:connection": "node --import tsx scripts/check-codex.ts --shared",
    "prepack": "npm run build",
    "check:claude": "node --import tsx scripts/check-claude.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.13.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "pinia": "^4.1.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "ws": "^8.21.3",
    "yaml": "^2.9.1"
  }
}
